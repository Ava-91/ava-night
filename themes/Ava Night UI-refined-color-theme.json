{
  "name": "Ava Night",
  "include": "./Ava Night-color-theme.json",
  "colors": {
    // Primary interaction: blue
    "focusBorder": "#61AFEF",
    "activityBar.activeBorder": "#61AFEF",
    "activityBar.activeFocusBorder": "#61AFEF",
    "tab.activeBorder": "#61AFEF",
    "tab.activeBorderTop": "#61AFEF",
    "panelTitle.activeBorder": "#61AFEF",
    "commandCenter.activeBorder": "#61AFEF",
    "inputOption.activeBorder": "#61AFEF",
    "statusBarItem.focusBorder": "#61AFEF",

    // Selection: deeper blue, intentionally distinct from focus
    "editor.selectionBackground": "#203A5C",
    "editor.selectionHighlightBackground": "#203A5C66",
    "editor.findRangeHighlightBackground": "#203A5C66",
    "peekViewResult.selectionBackground": "#203A5C",
    "list.activeSelectionBackground": "#203A5C",
    "list.inactiveSelectionBackground": "#1B2A40",
    "list.dropBackground": "#203A5C",
    "menu.selectionBackground": "#203A5C",
    "inputOption.activeBackground": "#203A5C",
    "commandCenter.activeBackground": "#203A5C",
    "statusBarItem.activeBackground": "#203A5C",
    "badge.background": "#203A5C",
    "profileBadge.background": "#203A5C",

    // Hover: quieter blue so hover does not compete with focus
    "editor.hoverHighlightBackground": "#2B4A6B55",
    "editor.dropBackground": "#2B4A6B66",
    "list.hoverBackground": "#2B4A6B55",
    "tab.hoverBackground": "#2B4A6B55",
    "statusBarItem.hoverBackground": "#2B4A6B55",
    "button.secondaryHoverBackground": "#30445C",
    "extensionButton.prominentHoverBackground": "#7FDBFF",

    // Bright cyan: high-attention interactive states and cursor
    "editorCursor.foreground": "#7FDBFF",
    "editorLineNumber.activeForeground": "#7FDBFF",
    "button.hoverBackground": "#7FDBFF",
    "activityBarBadge.background": "#7FDBFF",
    "activityBarBadge.foreground": "#0F1117",

    // Informational UI keeps the primary blue role
    "editorInfo.foreground": "#61AFEF",
    "editorInfo.border": "#61AFEF30",
    "inputValidation.infoBackground": "#61AFEF",
    "inputValidation.infoBorder": "#61AFEF",
    "minimap.findMatchHighlight": "#61AFEF",
    "merge.currentHeaderBackground": "#61AFEF30",
    "merge.currentContentBackground": "#61AFEF15",

    // Buttons: solid blue for primary actions, neutral surfaces for secondary actions
    "button.background": "#61AFEF",
    "button.foreground": "#0F1117",
    "button.secondaryBackground": "#242C3A",
    "button.secondaryForeground": "#D8DEE9",
    "extensionButton.prominentBackground": "#61AFEF",
    "extensionButton.prominentForeground": "#0F1117"
  }
}
