"semanticHighlighting": true,
"semanticTokenColors": {
	// Classes and types
	"class": "#FFD166",
	"class.decorator": "#B48EFA",
	"enum": "#FFD166",
	"enumMember": "#FFD166",
	"interface": "#FFD166",
	"type": "#FFD166",
	"type.parameter": "#E5C07B",
	
	// Functions and methods
	"function": "#61AFEF",
	"method": "#61AFEF",
	"macro": "#61AFEF",
	"function.decorator": "#B48EFA",
	
	// Variables
	"variable": "#D8DEE9",
	"variable.readonly": "#D8DEE9",
	"variable.defaultLibrary": "#D8DEE9",
	"variable.member": "#D8DEE9",
	"variable.static": "#FFD166",
	"variable.constant": "#E5C07B",
	"variable.mutable": "#D8DEE9",
	"variable.parameter": "#E5C07B",
	
	// Properties
	"property": "#D8DEE9",
	"property.static": "#FFD166",
	"property.readonly": "#D8DEE9",
	
	// Namespaces and modules
	"namespace": "#B48EFA",
	"module": "#B48EFA",
	
	// Comments and docs
	"comment": "#667085",
	
	// Keywords
	"keyword": "#B48EFA",
	"keyword.control": "#B48EFA",
	"keyword.operator": "#61AFEF",
	
	// Strings
	"string": "#98C379",
	"string.escape": "#7FDBFF",
	
	// Numbers
	"number": "#E5C07B",
	"number.float": "#E5C07B",
	"number.hex": "#E5C07B",
	
	// Regex
	"regexp": "#7FDBFF",
	
	// Errors
	"error": "#F07178",
	
	// Builtins
	"builtin": "#61AFEF",
	
	// Other
	"label": "#98C379",
	"escape": "#7FDBFF",
	"event": "#61AFEF",
	"operator": "#61AFEF",
	"typeOperator": "#B48EFA"
},
"tokenColors": [
	{
		"name": "Comment",
		"scope": [
			"comment",
			"punctuation.definition.comment"
		],
		"settings": {
			"fontStyle": "italic",
			"foreground": "#667085"
		}
	},
	{
		"name": "Variables",
		"scope": [
			"variable",
			"string constant.other.placeholder"
		],
		"settings": {
			"foreground": "#D8DEE9"
		}
	},
	{
		"name": "Colors",
		"scope": [
			"constant.other.color"
		],
		"settings": {
			"foreground": "#D8DEE9"
		}
	},
	{
		"name": "Invalid",
		"scope": [
			"invalid",
			"invalid.illegal"
		],
		"settings": {
			"foreground": "#F07178"
		}
	},
	{
		"name": "Keyword, Storage",
		"scope": [
			"keyword",
			"storage.type",
			"storage.modifier"
		],
		"settings": {
			"foreground": "#B48EFA"
		}
	},
	{
		"name": "Keyword Control",
		"scope": [
			"keyword.control"
		],
		"settings": {
			"foreground": "#B48EFA"
		}
	},
	{
		"name": "Operator, Misc",
		"scope": [
			"constant.other.color",
			"meta.tag",
			"punctuation.definition.tag",
			"punctuation.separator.inheritance.php",
			"punctuation.definition.tag.html",
			"punctuation.definition.tag.begin.html",
			"punctuation.definition.tag.end.html",
			"punctuation.section.embedded",
			"keyword.other.template",
			"keyword.other.substitution"
		],
		"settings": {
			"foreground": "#61AFEF"
		}
	},
	{
		"name": "Operators",
		"scope": [
			"keyword.operator",
			"keyword.operator.logical",
			"keyword.operator.arithmetic",
			"keyword.operator.assignment",
			"keyword.operator.bitwise",
			"keyword.operator.comparison",
			"keyword.operator.increment",
			"keyword.operator.decrement",
			"keyword.operator.ternary",
			"keyword.operator.new"
		],
		"settings": {
			"foreground": "#61AFEF"
		}
	},
	{
		"name": "Punctuation - Soft gray",
		"scope": [
			"punctuation",
			"punctuation.accessor",
			"punctuation.terminator",
			"punctuation.separator",
			"punctuation.section"
		],
		"settings": {
			"foreground": "#8A93A5"
		}
	},
	{
		"name": "Tag",
		"scope": [
			"entity.name.tag",
			"meta.tag.sgml",
			"markup.deleted.git_gutter"
		],
		"settings": {
			"foreground": "#F07178"
		}
	},
	{
		"name": "Function, Special Method",
		"scope": [
			"entity.name.function",
			"meta.function-call",
			"variable.function",
			"support.function",
			"keyword.other.special-method"
		],
		"settings": {
			"foreground": "#61AFEF"
		}
	},
	{
		"name": "Function Definition",
		"scope": [
			"meta.function entity.name.function",
			"meta.function-call entity.name.function"
		],
		"settings": {
			"foreground": "#61AFEF"
		}
	},
	{
		"name": "Block Level Variables",
		"scope": [
			"meta.block variable.other"
		],
		"settings": {
			"foreground": "#D8DEE9"
		}
	},
	{
		"name": "Other Variable, String Link",
		"scope": [
			"support.other.variable",
			"string.other.link"
		],
		"settings": {
			"foreground": "#D8DEE9"
		}
	},
	{
		"name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
		"scope": [
			"constant.numeric",
			"constant.language",
			"support.constant",
			"constant.character",
			"constant.escape",
			"variable.parameter",
			"keyword.other.unit",
			"keyword.other"
		],
		"settings": {
			"foreground": "#E5C07B"
		}
	},
	{
